# Kavach runtime configuration.
# Copy to .env. Nothing here may ever contain an external endpoint.

# Hardware profile: TINY | LOW | MID | HIGH
KAVACH_PROFILE=MID

# Model backend: mock | llamacpp
#   mock     - deterministic stub, no weights needed. Use for dev + CI.
#   llamacpp - talks to the llama.cpp servers on the internal docker network.
KAVACH_BACKEND=mock

# Root for run workspaces, sqlite state, audit chain
KAVACH_VAR_DIR=./var

# Directory holding the staged GGUF weights (digest-verified at boot)
KAVACH_MODEL_DIR=./models

# Fail startup if a weight file digest does not match the registry.
# Set to 0 ONLY for dev with the mock backend.
KAVACH_ENFORCE_DIGESTS=1

# Bind address for the gateway. Loopback by default - the UI is served same-origin.
KAVACH_HOST=127.0.0.1
KAVACH_PORT=8080

# Index synthetic VLM transcriptions for pages this box cannot really read.
# OFF by default and deliberately awkward to turn on, exactly like
# KAVACH_ALLOW_UNSANDBOXED_EXEC. With it set, a scanned page is "transcribed"
# by the mock backend and stored with extraction=SIMULATED: still stamped
# everywhere, still excluded from grounded answers, still refused as evidence.
# It exists so the OCR/VLM path can be exercised end to end before real vision
# weights are staged - never so a demo can show a full corpus.
KAVACH_KB_ALLOW_SIMULATED_OCR=0
